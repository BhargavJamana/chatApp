# Backend Environment Variables
# Copy this to .env in the backend directory and fill in the values

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (update when deployed to Vercel)
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=chatapp

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=7d

# CORS Settings
CORS_ORIGINS=http://localhost:3000,https://your-vercel-frontend.vercel.app
